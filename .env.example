# CFG Radio - environment template.
# Copy to `.env` and fill in the real values. Never commit `.env`.

# --- Required ---

# Bot token from the Discord Developer Portal (Bot > Token).
DISCORD_TOKEN=

# Application ID of the bot (Developer Portal > General Information).
DISCORD_CLIENT_ID=

# ID of the guild the slash commands are registered to.
DISCORD_GUILD_ID=

# --- Optional (defaults shown) ---

# One of: error, warn, info, debug
LOG_LEVEL=info

# Default playback volume, integer 0-100.
DEFAULT_VOLUME=100

# Seconds of inactivity before the bot leaves the voice channel, integer 0-86400.
IDLE_DISCONNECT_SECONDS=300

# FFmpeg executable used for audio transcoding.
# Leave empty to resolve "ffmpeg" through PATH; set an absolute path if it is
# installed somewhere else. Requires a build with libopus enabled.
FFMPEG_PATH=

# yt-dlp executable used to resolve YouTube tracks.
# Leave empty to resolve "yt-dlp" through PATH; set an absolute path if it is
# installed somewhere else.
YTDLP_PATH=

# Maximum valid tracks imported from one YouTube playlist, integer 1-500.
MAX_PLAYLIST_TRACKS=100
