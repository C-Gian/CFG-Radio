# CFG Radio - environment template.
# Copy to `.env` and fill in the real values. Never commit `.env`.

# --- Required ---

# Bot token from the Discord Developer Portal (Bot > Token).
DISCORD_TOKEN=

# Application ID of the bot (Developer Portal > General Information).
DISCORD_CLIENT_ID=

# ID of the guild the slash commands are registered to.
DISCORD_GUILD_ID=

# --- Optional (defaults shown) ---

# One of: error, warn, info, debug
LOG_LEVEL=info

# Default playback volume, integer 0-100.
DEFAULT_VOLUME=100

# Seconds of inactivity before the bot leaves the voice channel, integer 0-86400.
IDLE_DISCONNECT_SECONDS=300
